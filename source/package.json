{
  "name": "redmont-archives",
  "version": "2.0.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "dev": "node tools/local-server.mjs",
    "demo": "node tools/seed-demo.mjs",
    "test": "node tools/generate-schema.mjs && node --test tests/*.test.mjs",
    "check": "npm test && npm run build",
    "package": "npm run build && node tools/package-release.mjs",
    "deploy": "npx --yes wrangler@4.157.0 pages deploy dist --project-name redmontarchives --branch main"
  },
  "dependencies": {
    "dompurify": "3.4.17",
    "sanitize-html": "2.18.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
